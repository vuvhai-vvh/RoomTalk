<Window x:Class="RoomTalk.TestServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoomTalk"
        Title="RoomTalk - Máy chủ"
        Icon="Image/RoomTalk.ico"
        Width="1120" Height="760" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Window.Resources>
        <local:AccountRoleToTextConverter x:Key="RoleTextConverter"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#0F172A" Padding="22,14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Máy chủ RoomTalk" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Khởi động máy chủ và quản lý tài khoản liên lạc" Foreground="#CBD5E1" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Máy chủ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="15" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Cổng TCP" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,6,0,0" Padding="8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="18,0">
                                <TextBlock Text="IPv4 LAN" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LocalIpAddresses}" Foreground="#1D4ED8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Khởi động" Command="{Binding StartServerCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="Dừng" Command="{Binding StopServerCommand}" Height="38" Padding="16,4" Margin="8,0,0,0" Background="#DC2626" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding ConnectedClients}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="120"/>
                            <DataGridTextColumn Header="Tên máy" Binding="{Binding MachineName}" Width="1.4*"/>
                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
                            <DataGridTextColumn Header="Kết nối" Binding="{Binding ConnectedAtText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Tài khoản">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.9*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản / tên phòng" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="120"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="2" Padding="18" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button Content="Tạo mới" Command="{Binding NewAccountCommand}" DockPanel.Dock="Right" Width="90" Height="32"/>
                                <TextBlock Text="Thông tin tài khoản" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <TextBlock Text="Tên tài khoản cũng chính là tên phòng hiển thị. Mọi tài khoản sử dụng đều có thể gọi và nhận cuộc gọi." Foreground="#065F46" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Tên tài khoản / tên phòng"/>
                            <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditingExistingAccount}" Height="36" Margin="0,5,0,12" Padding="8"/>
                            <TextBlock Text="Mật khẩu mới"/>
                            <PasswordBox Height="36" Margin="0,5,0,12" Padding="8"
                                         local:PasswordBoxHelper.BindPassword="True"
                                         local:PasswordBoxHelper.BoundPassword="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Để trống nếu không đổi mật khẩu" Foreground="#64748B" Margin="0,-8,0,12"/>
                            <TextBlock Text="Vai trò"/>
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding EditRole}" Height="36" Margin="0,5,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RoleTextConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Content="Cho phép sử dụng" IsChecked="{Binding EditEnabled}" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Lưu" Command="{Binding SaveAccountCommand}" Style="{StaticResource PrimaryButton}" Width="100"/>
                                <Button Content="Xóa" Command="{Binding DeleteAccountCommand}" Width="90" Height="38" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="18,10">
            <DockPanel>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Width="90" Height="32"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#334155" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
