<Window x:Class="RoomTalk.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoomTalk"
        Title="Đăng nhập RoomTalk"
        Icon="Image/RoomTalk.ico"
        Width="650"
        Height="620"
        MinWidth="600"
        MinHeight="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="30,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Image/RoomTalk.ico" Width="58" Height="58" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Kết nối và đăng nhập" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ConnectionModeMessage}"
                               Foreground="#CBD5E1" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="26,22" Padding="26" Background="White" CornerRadius="10"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Kết nối" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"/>

                <Grid Margin="0,14,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocalServerAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="IP hoặc tên máy chủ" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cổng" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Margin="0,14,0,0" Padding="14" Background="#ECFDF5" CornerRadius="7"
                        BorderBrush="#6EE7B7" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLocalServerAccount}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Đăng nhập máy chủ cục bộ"
                                   FontWeight="SemiBold" Foreground="#065F46"/>
                        <TextBlock Text="Tài khoản máy chủ vào thẳng giao diện quản trị trên máy này; không cần nhập IP hoặc cổng."
                                   Margin="0,5,0,0" Foreground="#047857" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Separator Margin="0,22,0,20"/>

                <TextBlock Text="Tài khoản" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"/>
                <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Margin="0,18,0,7"/>
                <PasswordBox Style="{StaticResource PasswordStyle}"
                             local:PasswordBoxHelper.BindPassword="True"
                             local:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Border Margin="0,20,0,0" Padding="12" Background="#F8FAFC" CornerRadius="7"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Command="{Binding CancelCommand}" IsCancel="True"
                        Style="{StaticResource ActionButton}" Background="#E2E8F0" Foreground="#0F172A" Margin="0,0,12,0"/>
                <Button Content="Đăng nhập" Command="{Binding ConnectCommand}" IsDefault="True"
                        Style="{StaticResource ActionButton}" Background="#0F766E" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
