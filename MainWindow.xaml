<Window x:Class="RoomTalk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RoomTalk.Controls"
        Title="RoomTalk"
        Icon="Image/RoomTalk.ico"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="RoomButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Image/RoomTalk.ico" Width="48" Height="48" Margin="0,0,13,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RoomTalk" Foreground="White" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="Điều hành truyền âm thanh tới máy người dùng" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cài đặt" Command="{Binding OpenSettingsCommand}" Style="{StaticResource HeaderButton}"
                            Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}" Style="{StaticResource HeaderButton}" Background="#0F766E"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Margin="28" Padding="28" Background="White" CornerRadius="12"
                    Visibility="{Binding IsDisconnectedViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Kết nối RoomTalk" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tài khoản điều hành chọn người dùng để nói; tài khoản người dùng tự động nghe."
                               Foreground="#64748B" FontSize="15" TextAlignment="Center" Margin="0,10,0,22" TextWrapping="Wrap"/>
                    <Button Content="Đăng nhập" Command="{Binding LoginCommand}" Height="46" Background="#0F766E"
                            Foreground="White" BorderThickness="0" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Margin="22" Visibility="{Binding IsCommunicationViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUsername}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CallStatusText}" Foreground="#0F766E" FontSize="15" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding CallCountdownText}" Foreground="#B45309" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding IsMicrophoneMeterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding MicrophoneMeterText}" Foreground="#475569" Margin="0,0,0,5"/>
                            <controls:AudioWaveformMeter Level="{Binding MicrophoneLevel, Mode=OneWay}"
                                                             IsActive="{Binding IsCallActive, Mode=OneWay}"
                                                             Height="34"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAdminContactListVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="250" Margin="0,0,14,14" Padding="16" Background="White" CornerRadius="10"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Ellipse Width="12" Height="12" Margin="0,3,8,0" DockPanel.Dock="Left">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsBroadcasting}" Value="True">
                                                                <Setter Property="Fill" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding OnlineSummary}" Foreground="#64748B" Margin="0,9,0,0"/>
                                        <Button Content="{Binding ActionText}" IsEnabled="{Binding CanTalk}"
                                                Click="TalkButton_OnClick" Style="{StaticResource RoomButton}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="1" Margin="0,16,0,0" Padding="30" Background="White" CornerRadius="10"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding IsUserListenerViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
                        <TextBlock Text="Chế độ chỉ nghe" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CallStatusText}" Foreground="#0F766E" FontSize="18" FontWeight="SemiBold"
                                   TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Âm thanh sẽ tự phát khi tài khoản điều hành bắt đầu liên lạc. Microphone không được sử dụng."
                                   Foreground="#64748B" FontSize="15" TextAlignment="Center" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CallCountdownText}" Foreground="#B45309" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <Button Content="Kết thúc nghe" Command="{Binding EndCurrentCallCommand}" Width="220" Height="44"
                                Margin="0,22,0,0" Background="#DC2626" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold"
                                Visibility="{Binding IsUserEndCallVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8"
                        Padding="14" Margin="220,18,220,0" VerticalAlignment="Top" Panel.ZIndex="20"
                        Visibility="{Binding IsRecipientEndingWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Phiên sắp kết thúc" FontSize="17" FontWeight="Bold" Foreground="#92400E" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ExtensionCountdownNote}" Foreground="#92400E" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E2E8F0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="#334155"/>
                <TextBlock Grid.Column="1" Text="{Binding AccountStatus}" Foreground="#334155" Margin="22,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="#334155" TextAlignment="Right" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Background="#990F172A" Panel.ZIndex="100"
                Visibility="{Binding IsInitiatorExtensionPromptVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="500" Padding="28" Background="White" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Tiếp tục liên lạc?" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Phiên liên lạc đã đủ 1 phút." FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding ExtensionCountdownNote}" Foreground="#B45309" FontSize="15" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <Border Background="#FEF3C7" CornerRadius="50" Width="104" Height="104" Margin="0,20,0,20">
                        <TextBlock Text="{Binding ExtensionCountdownNumber}" FontSize="48" FontWeight="Bold" Foreground="#B45309"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Có, tiếp tục 1 phút" Command="{Binding ContinueCallCommand}" Height="46"
                                Background="#0F766E" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="15"/>
                        <Button Grid.Column="2" Content="Không, kết thúc" Command="{Binding EndCurrentCallCommand}" Height="46"
                                Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold" FontSize="15"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
