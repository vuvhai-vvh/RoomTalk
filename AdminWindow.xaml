<Window x:Class="RoomTalk.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản trị RoomTalk"
        Icon="Image/RoomTalk.ico"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#0F172A" Padding="22,13">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Quản trị RoomTalk" Foreground="White" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Kênh, phòng, tài khoản, thiết bị và cấu hình máy chủ" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18" TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="250"/>
                    <Setter Property="Height" Value="46"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Margin" Value="0,0,8,6"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Tổng quan">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tổng quan hệ thống" FontSize="22" FontWeight="SemiBold"/>
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
                        <Border Margin="0,0,10,0" Padding="18" Background="#EFF6FF" CornerRadius="8">
                            <StackPanel><TextBlock Text="Kênh" Foreground="#475569"/><TextBlock Text="1" FontSize="30" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Margin="5,0" Padding="18" Background="#F0FDF4" CornerRadius="8">
                            <StackPanel><TextBlock Text="Phòng" Foreground="#475569"/><TextBlock Text="4" FontSize="30" FontWeight="Bold"/></StackPanel>
                        </Border>
                        <Border Margin="10,0,0,0" Padding="18" Background="#FFF7ED" CornerRadius="8">
                            <StackPanel><TextBlock Text="Máy trực tuyến" Foreground="#475569"/><TextBlock Text="3" FontSize="30" FontWeight="Bold"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="2" Text="Các con số đang là dữ liệu minh họa cho bước thiết kế giao diện." Foreground="#64748B" Margin="0,18,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Quản lý kênh">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Quản lý kênh" FontSize="22" FontWeight="SemiBold"/>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                        <TextBox Width="300" Style="{StaticResource InputStyle}" Text="Tên kênh mới"/>
                        <Button Content="Tạo kênh" Width="110" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên kênh" Width="*"/>
                            <DataGridTextColumn Header="Số phòng" Width="120"/>
                            <DataGridTextColumn Header="Trạng thái" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Quản lý phòng">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Quản lý phòng" FontSize="22" FontWeight="SemiBold"/>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                        <TextBox Width="260" Style="{StaticResource InputStyle}" Text="Tên phòng mới"/>
                        <ComboBox Width="200" Height="36" Margin="10,0,0,0"><ComboBoxItem Content="Kênh chính"/></ComboBox>
                        <Button Content="Tạo phòng" Width="110" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phòng" Width="*"/>
                            <DataGridTextColumn Header="Kênh" Width="*"/>
                            <DataGridTextColumn Header="Thiết bị online" Width="140"/>
                            <DataGridTextColumn Header="Trạng thái" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Quản lý tài khoản">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Quản lý tài khoản" FontSize="22" FontWeight="SemiBold"/>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                        <TextBox Width="220" Style="{StaticResource InputStyle}" Text="Tên tài khoản"/>
                        <PasswordBox Width="200" Height="36" Margin="10,0,0,0"/>
                        <ComboBox Width="150" Height="36" Margin="10,0,0,0"><ComboBoxItem Content="User"/><ComboBoxItem Content="Administrator"/></ComboBox>
                        <Button Content="Tạo tài khoản" Width="125" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản" Width="*"/>
                            <DataGridTextColumn Header="Vai trò" Width="150"/>
                            <DataGridTextColumn Header="Kết nối" Width="130"/>
                            <DataGridTextColumn Header="Kích hoạt" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Gán tài khoản vào phòng">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Gán tài khoản vào phòng" FontSize="22" FontWeight="SemiBold"/>
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12">
                        <ComboBox Width="240" Height="36"><ComboBoxItem Content="Chọn tài khoản"/></ComboBox>
                        <ComboBox Width="240" Height="36" Margin="10,0,0,0"><ComboBoxItem Content="Chọn phòng"/></ComboBox>
                        <Button Content="Gán phòng" Width="110" Margin="10,0,0,0"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản" Width="*"/>
                            <DataGridTextColumn Header="Phòng được gán" Width="2*"/>
                            <DataGridTextColumn Header="Trạng thái đăng nhập" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Loa IP ">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Quản lý loa IP " FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Quét dải IPv4, nhận diện dịch vụ HTTP/HTTPS/RTSP/ISAPI, thêm IP thủ công và gán loa vào phòng."
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            Padding="14"
                            Background="#EFF6FF"
                            CornerRadius="8"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="IP bắt đầu" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ScanStartIp, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="IP kết thúc" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding ScanEndIp, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Quét dải mạng"
                                    Command="{Binding ScanNetworkCommand}"
                                    Height="36"
                                    Padding="16,5"
                                    Margin="0,23,8,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"/>

                            <Button Grid.Column="3"
                                    Content="Hủy quét"
                                    Command="{Binding CancelScanCommand}"
                                    Height="36"
                                    Padding="16,5"
                                    Margin="0,23,0,0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <ProgressBar Height="14"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ScanPercent, Mode=OneWay}"/>
                            <TextBlock Text="{Binding ScanProgressText, Mode=OneWay}"
                                       Foreground="#475569"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <Button Content="Làm mới tất cả"
                                    Command="{Binding RefreshAllSpeakersCommand}"
                                    Height="36"
                                    Padding="14,5"/>
                            <Button Content="Lưu danh sách"
                                    Command="{Binding SaveSpeakersCommand}"
                                    Height="36"
                                    Padding="14,5"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding NetworkSpeakers}"
                                  SelectedItem="{Binding SelectedNetworkSpeaker, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên loa" Binding="{Binding Name}" Width="1.25*"/>
                                <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="*"/>
                                <DataGridTextColumn Header="Hãng" Binding="{Binding Manufacturer}" Width="1.15*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="1.1*"/>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="*"/>
                                <DataGridTextColumn Header="Giao thức" Binding="{Binding Protocol}" Width="1.45*"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Margin="0,0,7,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                    <Setter Property="Fill" Value="#F59E0B"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                                    <Setter Property="Fill" Value="#3B82F6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ScrollViewer Grid.Column="1"
                                      Margin="14,0,0,0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Padding="14"
                                        Background="#F8FAFC"
                                        CornerRadius="8"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Thêm loa bằng IP"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="Tên hiển thị" Margin="0,12,0,5"/>
                                        <TextBox Text="{Binding NewSpeakerName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}"/>

                                        <TextBlock Text="Địa chỉ IPv4" Margin="0,10,0,5"/>
                                        <TextBox Text="{Binding NewSpeakerIp, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}"/>

                                        <TextBlock Text="Cổng quản lý" Margin="0,10,0,5"/>
                                        <TextBox Text="{Binding NewSpeakerPort, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}"/>

                                        <TextBlock Text="Gán vào phòng" Margin="0,10,0,5"/>
                                        <ComboBox ItemsSource="{Binding RoomNames}"
                                                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                                  Height="36"/>

                                        <Button Content="Thêm và kiểm tra"
                                                Command="{Binding AddManualSpeakerCommand}"
                                                Height="38"
                                                Margin="0,12,0,0"
                                                Background="#0F766E"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0"
                                        Padding="14"
                                        Background="#FFF7ED"
                                        CornerRadius="8"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Thiết bị đang chọn"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedNetworkSpeaker.Name, TargetNullValue='Chưa chọn thiết bị'}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding SelectedNetworkSpeaker.IpAddress}"
                                                   Foreground="#475569"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding SelectedNetworkSpeaker.Note}"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"/>

                                        <TextBlock Text="Chuyển sang phòng" Margin="0,12,0,5"/>
                                        <ComboBox ItemsSource="{Binding RoomNames}"
                                                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                                  Height="36"/>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Kiểm tra kết nối"
                                                    Command="{Binding RefreshSelectedSpeakerCommand}"
                                                    Height="36"
                                                    Padding="12,5"/>
                                            <Button Content="Gán phòng"
                                                    Command="{Binding AssignRoomCommand}"
                                                    Height="36"
                                                    Padding="12,5"
                                                    Margin="8,0,0,0"/>
                                            <Button Content="Xóa"
                                                    Command="{Binding DeleteSelectedSpeakerCommand}"
                                                    Height="36"
                                                    Padding="12,5"
                                                    Margin="8,0,0,0"
                                                    Foreground="#B91C1C"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="#F1F5F9"
                            CornerRadius="7">
                        <TextBlock Text="{Binding NetworkStatusMessage, Mode=OneWay}"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Máy đang kết nối">
                <Grid Margin="22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Máy đang kết nối" FontSize="22" FontWeight="SemiBold"/>
                    <DataGrid Grid.Row="1" Margin="0,16,0,0" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tài khoản" Width="*"/>
                            <DataGridTextColumn Header="Tên máy" Width="*"/>
                            <DataGridTextColumn Header="IP" Width="*"/>
                            <DataGridTextColumn Header="Phòng" Width="*"/>
                            <DataGridTextColumn Header="Mic/Loa" Width="120"/>
                            <DataGridTextColumn Header="Trạng thái" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Máy chủ &amp; CSDL">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Cấu hình máy chủ" FontSize="22" FontWeight="SemiBold"/>
                        <UniformGrid Columns="2" Margin="0,16,0,0">
                            <StackPanel Margin="0,0,10,12"><TextBlock Text="IP lắng nghe" Margin="0,0,0,5"/><TextBox Text="0.0.0.0" Style="{StaticResource InputStyle}"/></StackPanel>
                            <StackPanel Margin="10,0,0,12"><TextBlock Text="Cổng điều khiển" Margin="0,0,0,5"/><TextBox Text="5000" Style="{StaticResource InputStyle}"/></StackPanel>
                            <StackPanel Margin="0,0,10,12"><TextBlock Text="Cổng âm thanh" Margin="0,0,0,5"/><TextBox Text="5001" Style="{StaticResource InputStyle}"/></StackPanel>
                            <StackPanel Margin="10,0,0,12"><TextBlock Text="Trạng thái" Margin="0,0,0,5"/><TextBox Text="Chưa khởi động" IsReadOnly="True" Style="{StaticResource InputStyle}"/></StackPanel>
                        </UniformGrid>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Khởi động máy chủ" Height="38" Padding="16,5"/>
                            <Button Content="Dừng máy chủ" Height="38" Padding="16,5" Margin="10,0,0,0"/>
                        </WrapPanel>

                        <Separator Margin="0,24"/>

                        <TextBlock Text="Lưu trữ dữ liệu" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Hiện tại RoomTalk dùng file JSON. Khi chuyển sang CSDL, chỉ máy chủ cần cấu hình phần này; các máy trạm vẫn chỉ nhập IP và tài khoản RoomTalk."
                                   TextWrapping="Wrap" Foreground="#64748B" Margin="0,7,0,14"/>
                        <CheckBox x:Name="UseDatabaseCheckBox" Content="Sử dụng cơ sở dữ liệu thay cho file JSON"/>

                        <Border IsEnabled="{Binding IsChecked, ElementName=UseDatabaseCheckBox}"
                                Margin="0,12,0,0" Padding="16" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12"><TextBlock Text="Loại CSDL" Margin="0,0,0,5"/><ComboBox Height="36"><ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="SQLite"/></ComboBox></StackPanel>
                                    <StackPanel Margin="10,0,0,12"><TextBlock Text="Máy chủ CSDL" Margin="0,0,0,5"/><TextBox Text="localhost" Style="{StaticResource InputStyle}"/></StackPanel>
                                    <StackPanel Margin="0,0,10,12"><TextBlock Text="Cổng CSDL" Margin="0,0,0,5"/><TextBox Text="1433" Style="{StaticResource InputStyle}"/></StackPanel>
                                    <StackPanel Margin="10,0,0,12"><TextBlock Text="Tên CSDL" Margin="0,0,0,5"/><TextBox Text="RoomTalk" Style="{StaticResource InputStyle}"/></StackPanel>
                                    <StackPanel Margin="0,0,10,12"><TextBlock Text="Tài khoản CSDL" Margin="0,0,0,5"/><TextBox Style="{StaticResource InputStyle}"/></StackPanel>
                                    <StackPanel Margin="10,0,0,12"><TextBlock Text="Mật khẩu CSDL" Margin="0,0,0,5"/><PasswordBox Height="36" Padding="9,5"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Kiểm tra kết nối CSDL" Height="38" Padding="16,5"/>
                                    <Button Content="Lưu cấu hình" Height="38" Padding="16,5" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
